# Copy to .env (git-ignored). Read by `make dev`, `make start` and docker compose.

# Port the server listens on (and is published on with docker compose).
PORT=8080

# Public origin users reach Awake at, without a path: https://awake.example.com in production.
# Used for login-provider redirects, set-password links, secure cookies and the Origin check.
# Default: http://localhost:<PORT>
PUBLIC_URL=

# Set to true behind a reverse proxy (required in production: Awake speaks plain HTTP, HTTPS is the
# proxy's job), so the client IP for rate limiting comes from X-Forwarded-For.
TRUST_PROXY=false

# Where the SQLite database lives (default ./data; /data in the Docker image).
DATA_DIR=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ---------- accounts ----------
# On first start an `admin` user is created; its password is printed once in the logs and must be
# changed at the first login. Lost it? `make reset-password ACCOUNT=admin` (or the docker compose
# command in the README).

# Can people create their own account (password or login provider)?
REGISTRATION_ENABLED=false
# Are self-registered accounts active right away, or pending until an admin approves them?
REGISTRATION_AUTO_APPROVE=false

# Sessions expire after this many days without use.
SESSION_TTL_DAYS=30
# Set-password links created by admins expire after this many hours.
PASSWORD_LINK_TTL_HOURS=72

# ---------- login providers (OAuth 2 / OpenID Connect) ----------
# Comma-separated ids; each one is configured with OAUTH_<ID>_* below. Register this redirect URI at
# the provider: <PUBLIC_URL>/api/auth/oauth/<id>/callback
# `google` and `github` are presets: only the client id and secret are needed. Any other id is a
# generic OpenID Connect provider (Authentik, Keycloak, Authelia, Zitadel…) and needs an ISSUER.
OAUTH_PROVIDERS=

# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# Generic OIDC example (OAUTH_PROVIDERS=authentik):
# OAUTH_AUTHENTIK_ISSUER=https://auth.example.com/application/o/awake/
# OAUTH_AUTHENTIK_CLIENT_ID=
# OAUTH_AUTHENTIK_CLIENT_SECRET=
# OAUTH_AUTHENTIK_LABEL=Authentik            # button text, default: the id
# OAUTH_AUTHENTIK_SCOPES=openid email profile # default
# OAUTH_AUTHENTIK_TYPE=oidc                  # oidc (default) or github
